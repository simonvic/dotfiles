	"disk": {
		"interval": 300,
		"path": "/",
		"format": "󰋊 {percentage_used}%",
		"tooltip-format": "{used} / {total}"
	},
	"disk#tmp": {
		"interval": 60,
		"path": "/tmp",
		"format": "󰋊 {percentage_used}%",
		"tooltip-format": "tmpfs {used} / {total}"
	},
	"group/power": {
		"orientation": "inherit",
		"drawer": {
			"transition-duration": 500,
			"transition-left-to-right": false
		},
		"modules": [
			"custom/group-power",
			"custom/power",
			"custom/suspend",
			"custom/reboot",
			"custom/lock",
			"custom/logout"
		]
	},
	"custom/group-power": {
		"format": "󰐦",
		"tooltip": false
	},
	"custom/logout": {
		"format": "󰗼",
		"tooltip-format": "logout",
		"on-click": "swaymsg exit"
	},
	"custom/lock": {
		"format": "󰍁",
		"tooltip-format": "lock",
		"on-click": "swaylock"
	},
	"custom/reboot": {
		"format": "󰜉",
		"tooltip-format": "reboot",
		"on-click": "reboot"
	},
	"custom/suspend": {
		"format": "󰒲",
		"tooltip-format": "suspend",
		"on-click": "reboot"
	},
	"custom/power": {
		"format": "",
		"tooltip-format": "shutdown",
		"on-click": "shutdown now"
	},
	"privacy": {
		"icon-size": 20,
		"modules": [
			{
				"type": "screenshare",
				"tooltip": true,
				"tooltip-icon-size": 22
			},
			{
				"type": "audio-out",
				"tooltip": true,
				"tooltip-icon-size": 22
			},
			{
				"type": "audio-in",
				"tooltip": true,
				"tooltip-icon-size": 22
			}
		]
	},
	"custom/aur": {
		"interval": 3600,
		"format": " {}",
		"return-type": "json",
		"tooltip-format": "<tt>{alt}</tt>",
		"exec": "printf '{\"text\":\"%s\",\"alt\":\"%s\"}' \"$(auracle outdated | wc -l)\" \"$(auracle outdated | sed 's/-> //' | column -t | tr '\n' '\r' )\"",
		"on-click": "i3-sensible-terminal -e 'auracle outdated' --hold",
		"on-click-right": "printf '{\"text\":\"%s\",\"alt\":\"%s\"}' \"$(auracle outdated | wc -l)\" \"$(auracle outdated | sed 's/-> //' | column -t | tr '\n' '\r' )\""
	},
	"custom/fan": {
		"interval": 3,
		"format": "󰈐 {} {alt}",
		"return-type": "json",
		"tooltip-format": "cpu: {}\ngpu: {alt}",
		"exec": "printf '{\"text\":\"%s\",\"alt\":\"%s\"}' \"$(sensors | grep cpu_fan | cut -d: -f2 | tr -d ' ')\" \"$(sensors | grep gpu_fan | cut -d: -f2 | tr -d ' ')\""
	},
	"custom/tlp": {
		"interval": 5,
		"signal": 1,
		"format": "{}",
		"return-type": "json",
		"tooltip-format": "{alt}",
		"on-click": "sBatteryctl power ac",
		"on-click-right": "sBatteryctl power auto",
		"on-click-middle": "sBatteryctl power bat",
		"exec": "mode=$(tlp-stat -m); icon=$(case $mode in *AC) echo '';; *AC*manual*) echo 󰠠;; *BAT) echo 󰌪;; *BAT*manual*) echo 󱤅;; *SAV*) echo 󰾆;; esac); printf '{\"text\":\"%s\",\"alt\":\"%s\"}' \"$icon\" \"TLP mode: $icon $mode\""
		// 󱐋 AC
		// 󰠠 AC (manual)
		// 󰌪 battery
		// 󱤅 battery (manual)
		// 󰾆 power saver
	},
	"custom/tlp#extended": {
		"interval": 5,
		"signal": 1,
		"format": "{}",
		"return-type": "json",
		"tooltip-format": "{alt}",
		"on-click": "sBatteryctl power ac",
		"on-click-right": "sBatteryctl power auto",
		"on-click-middle": "sBatteryctl power bat",
		"exec": "mode=$(tlp-stat -m); icon=$(case $mode in *AC) echo 󱐋;; *AC*manual*) echo 󰠠;; *BAT) echo 󰌪;; *BAT*manual*) echo 󱤅;; *SAV*) echo 󰾆;; esac); printf '{\"text\":\"%s\",\"alt\":\"%s\"}' \"$icon $mode\" \"TLP mode: $icon $mode\""
	},
	"custom/redshift": {
		"interval": 5,
		"signal": 1,
		"format": "{}",
		"return-type": "json",
		"tooltip-format": "{alt}",
		"exec": "temperature=$(sBrightnessctl r print); stateFile=${XDG_DATA_HOME:-$HOME/.local/share}/simonvic/sBrightnessctl/redshift.sh; enabled=$(cat $stateFile | grep Enabled | cut -d= -f2); icon=$(case $enabled in true) echo 󰌵 ;; false) echo 󰌶 ;; esac); printf '{\"text\":\"%s\",\"alt\":\"%s\"}' \"$icon\" \"$icon $temperature K\"",
		"on-click": "sBrightnessctl redshift toggle",
		"on-scroll-up": "sBrightnessctl redshift increase 400",
		"on-scroll-down": "sBrightnessctl redshift decrease 400"
	},
	"custom/redshift#extended": {
		"interval": 5,
		"signal": 1,
		"format": "{}",
		"return-type": "json",
		"tooltip-format": "{alt}",
		"exec": "temperature=$(sBrightnessctl r print); stateFile=${XDG_DATA_HOME:-$HOME/.local/share}/simonvic/sBrightnessctl/redshift.sh; enabled=$(cat $stateFile | grep Enabled | cut -d= -f2); icon=$(case $enabled in true) echo 󰌵 ;; false) echo 󰌶 ;; esac); printf '{\"text\":\"%s\",\"alt\":\"%s\"}' \"$icon $temperature K\" \"$icon $temperature K\"",
		"on-click": "sBrightnessctl redshift toggle",
		"on-scroll-up": "sBrightnessctl redshift increase 400",
		"on-scroll-down": "sBrightnessctl redshift decrease 400"
	},
	"custom/rss" : {
		"interval": 3600,
		"format": "{}",
		"return-type": "json",
		"tooltip-format": "{alt}",
		"exec": "sNews fetch 2> /dev/null; xml=$(sNews check); count=$(xmllint --xpath 'count(//item)' - <<< \"$xml\"); titles=$(xmllint --xpath '//item[position()<=99]/title/text()' - <<< \"$xml\"); printf '{\"text\":\"%s\",\"alt\":\"%s\"}' \" $count\" \"$(printf '%s' \"$titles\" | sed 's/^/· /' | tr '\n' '\r' )\"",
		"on-click": "sNews fetch"
	},
	"custom/ufw" : {
		"interval": 5,
		"format": "{}",
		"return-type": "json",
		"tooltip-format": "{alt}",
		"exec": "ufw_status=$(sudo ufw status); read -r _ ufw_active_status <<< $(grep Status <<< $ufw_status); icon=$(case $ufw_active_status in active) echo '';; inactive) echo '';; *) echo ?;; esac); printf '{\"text\":\"%s\",\"alt\":\"%s\"}' \"$icon\" \"$(printf '%s' \"<small><tt>$ufw_status</tt></small>\" | tr '\n' '\r')\""
	}

}
