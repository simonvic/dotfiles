				"󰋋 󰖀",
				"󰋋 󰕾",
				"󰋋 󰕾",
				"󰋋 󱄡"
			],
			"headset": [
				"󰋎 󰕿",
				"󰋎 󰖀",
				"󰋎 󰕾",
				"󰋎 󰕾",
				"󰋎 󱄡"
			],
			"phone": [
