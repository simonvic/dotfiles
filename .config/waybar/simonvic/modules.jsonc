			],
			"hifi": [
				"󰦢 󰕿",
				"󰦢 󰖀",
				"󰦢 󰕾",
				"󰦢 󰕾",
				"󰦢 󱄡"
			],
			"car": [
				" 󰕿",
				" 󰖀",
				" 󰕾",
				" 󰕾",
				" 󱄡"
