	"pulseaudio#extended": {
		"format": "{icon} {volume:3d}% {format_source}\n<span size='x-small'>{desc}</span>",
		"format-muted": "󰝟 {volume:3d}% {format_source}\n<span size='x-small'>{desc}</span>",
