#!/bin/bash

# Consult the i3lock man page for a better explanation on some settings

#                                                                       OPTIONS

# Stop all players on suspend
stopAllPlayersOnSuspend=true

# Show currently playing song in the lockscreen as the greeter
showSongAsGreeter=true

#                                                                          TEXT
# RRGGBBaa
textColor=DADADAff
font="LatoLight"
verifyText="..."
wrongText="!!!"
noInputText="___"
inputTypeColor="F0544Caa"
inputDeleteColor="FF1010ff"

#                                                                    BACKGROUND

# Backgrounds available:
# - color (rrggbbaa, transparency can be blurred with picom)
# - image
# - simpleBlur (i3lock-color blur method)
# - magick (blur and dim, uses scrot and imagemagick)
bgType=color

# RRGGBBaa
# Used only if `bgType` is `color`
bgColor="000000aa"

# Path to image
# Used only if `bgType` is `image`
bgImage="$HOME/.config/i3/desktop_wallpaper"

# Screenshot scale factor.
# Used only if `bgType` is `magick`
# To improve performance, Magick will scale down the image, apply the filters
# and then scale back up
bgScaleFactor=10

# Sigma value for the blur effect
# Used only if `bgType` is `magick`
bgBlurSigma=8

# How much (percentage) the screenshot has to be dimmed
# Used only if `bgType` is `magick`
bgDim=20

#                                                                     INDICATOR

# Available options: ring, bars
indicatorType=ring

# x:y
indicatorPos="w/2:h/2+250"

#                                                                          TIME
timeString="%H:%M:%S"
# x:y
timePos="ix:iy-250"
timeSize=150

#                                                                          DATE
dateString="%A, %d %B"
datePos="tx:ty+100"
dateSize=30

#                                                                       GREETER
# Show some text as greeter
# (Will be overridden if showSongAsGreeter is set to true)
greeterText=""
greeterPos="ix:iy+r+75"
greeterSize=20

#                                                                          RING
# Settings for the ring
radius=90
ringWidth=15
insideColor="00000000"
insideVerifyingColor="00000000"
insideWrongColor="00000000"
ringColor="00000055"
ringVerifyingColor="F0544C55"
ringWrongColor="F0544Cff"
separatorColor="F0544Cff"

# Settings for the bars
# 0 = down, 1 = up, 2 = both
barDirection=2
barMaxHeight=100
barCount=25
barBaseWidth=1
barBaseColor="00000000"
barStep=1
barPeriodicStep=10
barPosition=540

# Arguments to pass to i3lock
i3lockArgs=(
	"--pass-media-keys"
	"--pass-screen-keys"
	"--pass-power-keys"
	"--pass-volume-keys"
	"--redraw-thread"
	"--force-clock"
	"--line-uses-ring"
)

# NOTE: filetype extension matters. (e.g. png(lossless), jpg(lossy))
tempScreenshotFile=/tmp/simonvic/sLockscreenctl/tempScreenshot.jpg

###############################################################################

usercfg=${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/${0##*/}.sh
[[ -e "$usercfg" ]] && source "$usercfg"

###############################################################################

function takeScreenshot() {
	if [[ ! -e $tempScreenshotFile ]]; then
		mkdir -p "${tempScreenshotFile%/*}"
	fi
	case "$XDG_SESSION_TYPE" in
		wayland) grim "$tempScreenshotFile" ;;
		x11) scrot -z -o "$tempScreenshotFile" ;;
	esac
}

function blurScreenshot() {
	magick "$tempScreenshotFile" \
		-scale "$bgScaleFactor%" \
		-blur "0x$bgBlurSigma" \
		-colorize "$bgDim%" \
		-resize "$((100 * 100 / bgScaleFactor))%" \
		"$tempScreenshotFile"
}

function lockscreen() {
	if [[ $showSongAsGreeter == true ]]; then
		greeterText=$(sPlayerctl info 2> /dev/null)
	fi
	case "$XDG_SESSION_TYPE" in
		wayland)
			if [[ "$bgType" == "magick" ]]; then
				takeScreenshot && blurScreenshot
			fi
			swaylock -f
			;;
		x11)
			i3lockArgs+=(
				"--keyhl-color=$inputTypeColor"
				"--bshl-color=$inputDeleteColor"
				"--separator-color=$separatorColor"
				"--verif-color=$textColor"
				"--wrong-color=$textColor"
				"--time-color=$textColor"
				"--time-str=$timeString"
				"--time-font=$font"
				"--time-size=$timeSize"
				"--ind-pos=$indicatorPos"
				"--time-pos=$timePos"
				"--date-pos=$datePos"
				"--date-color=$textColor"
				"--date-str=$dateString"
				"--date-font=$font"
				"--date-size=$dateSize"
				"--inside-color=$insideColor"
				"--insidever-color=$insideVerifyingColor"
				"--insidewrong-color=$insideWrongColor"
				"--ring-color=$ringColor"
				"--ringver-color=$ringVerifyingColor"
				"--ringwrong-color=$ringWrongColor"
				"--greeter-color=$textColor"
				"--greeter-font=$font"
				"--greeter-size=$greeterSize"
				"--greeter-pos=$greeterPos"
				"--greeter-text=$greeterText"
				"--verif-text=$verifyText"
				"--wrong-text=$wrongText"
				"--noinput-text=$noInputText"
			)

			case "$indicatorType" in
				ring) i3lockArgs+=("--radius=$radius" "--ring-width=$ringWidth") ;;
				bars)
					i3lockArgs+=(
						"--bar-indicator"
						"--bar-direction=$barDirection"
						"--bar-max-height=$barMaxHeight"
						"--bar-count=$barCount"
						"--bar-base-width=$barBaseWidth"
						"--bar-color=$barBaseColor"
						"--bar-step=$barStep"
						"--bar-periodic-step=$barPeriodicStep"
						"--bar-pos=$barPosition"
					)
					;;
			esac

			case "$bgType" in
				color) i3lockArgs+=("--color=$bgColor") ;;
				image) i3lockArgs+=("--image=$bgImage") ;;
				simpleBlur) i3lockArgs+=("--blur=$bgBlurSigma") ;;
				magick)
					takeScreenshot && blurScreenshot
					i3lockArgs+=("--image=$tempScreenshotFile")
					;;
			esac

			pgrep i3lock || i3lock "${i3lockArgs[@]}"
			;;
	esac
}

function printUsage() {
	printf "%s\n" "
- Usage
	sLockscreenctl <options>

- Options
	suspend   # Lock the screen and suspend
	lock      # Lock the screen

- Abbreviations
	s = suspend
	l = lock
"
}

case "$1" in
	s | suspend)
		if [[ $stopAllPlayersOnSuspend == true ]]; then
			sPlayerctl pause all 2> /dev/null
		fi
		lockscreen
		systemctl suspend
		;;
	l | lock) lockscreen ;;
	help | *) printUsage ;;
esac
